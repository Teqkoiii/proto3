+              onChange={(e) => setText(e.target.value)}
+            />
+            <button
+              type="submit"
+              className="chat-send-button"
+              disabled={!text.trim() || sending}
+              aria-label="Nachricht senden"
+            >
+              <Send size={15} />
+            </button>
+          </form>
+        </div>
+      )}
+    </div>
+  );
+}

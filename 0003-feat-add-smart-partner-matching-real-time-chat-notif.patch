+++ b/src/features/gym/ChatDrawer.tsx
@@ -0,0 +1,327 @@
+import { useEffect, useRef, useState } from 'react';
+import {
+  ArrowLeft,
+  Check,
+  Dumbbell,
+  MessageSquare,
+  Minimize2,
+  Send,
+  Sparkles,
+  Users,
+  X,
+} from 'lucide-react';
+import {
+  createOrGetConversation,
+  sendChatMessage,
+  subscribeToMessages,
+  type CloudChatMessage,
+  type CloudConversation,
+} from '../../services/communityChatService';
+import type { CommunityMember } from '../../services/gymRepository';
+
+const QUICK_PROMPTS = [
+  'Bin in 10 Min da! 💪',
+  'Heute Brust & Trizeps?',
+  'Lust auf eine gemeinsame Session?',
+  'Super, bis gleich im Gym!',
+];
+
+export function ChatDrawer({
+  isOpen,
+  onClose,
+  currentUserId,
+  currentUserName,
+  activePartner,
+  conversations,
+  onSelectPartner,
+  onLoginWithGoogle,
+}: {
+  isOpen: boolean;
+  onClose: () => void;
+  currentUserId: string;
+  currentUserName: string;
+  activePartner: CommunityMember | null;
+  conversations: CloudConversation[];
+  onSelectPartner: (partner: CommunityMember | null) => void;
+  onLoginWithGoogle?: () => void;
+}) {
+  const [conversationId, setConversationId] = useState<string | null>(null);
+  const [messages, setMessages] = useState<CloudChatMessage[]>([]);
+  const [text, setText] = useState('');
+  const [sending, setSending] = useState(false);
+  const messagesEndRef = useRef<HTMLDivElement>(null);
+
+  // Initialize or fetch conversation when activePartner changes
+  useEffect(() => {
+    let active = true;
+    if (!activePartner || !currentUserId) {
+      setConversationId(null);
+      setMessages([]);
+      return;
+    }
+
+    const partnerName = `${activePartner.firstName} ${activePartner.lastNameInitial}.`.trim();
+    void createOrGetConversation(currentUserId, currentUserName, activePartner.id, partnerName).then(
+      (convId) => {
+        if (active) {
+          setConversationId(convId);
+        }
+      },
+    );
+
+    return () => {
+      active = false;
+    };
+  }, [activePartner, currentUserId, currentUserName]);
+
+  // Subscribe to real-time messages
+  useEffect(() => {
+    if (!conversationId) return;
+    const unsub = subscribeToMessages(conversationId, (msgs) => {
+      setMessages(msgs);
+    });
+    return () => unsub();
+  }, [conversationId]);
+
+  // Scroll to bottom on new message
+  useEffect(() => {
+    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
+  }, [messages]);
+
+  if (!isOpen) return null;
+
+  const handleSend = async (customText?: string) => {
+    const toSend = customText || text;
+    if (!toSend.trim() || !conversationId || sending) return;
+
+    setSending(true);
+    try {
+      await sendChatMessage(
+        conversationId,
+        currentUserId,
+        currentUserName,
+        toSend.trim(),
+        activePartner?.id,
+      );
+      if (!customText) setText('');
+    } finally {
+      setSending(false);
+    }
+  };
+
+  return (
+    <div className="chat-drawer-container surface" role="dialog" aria-label="Gym Chat">
+      {/* Header */}

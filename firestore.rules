rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isVerifiedDhbwUser() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             request.auth.token.email.lower().matches('^[^@]+@(bad-mergentheim\\.dhbw\\.de|badmergentheim\\.dhbw\\.de|dhbw-mannheim\\.de|dhbw-mosbach\\.de|dhbw-stuttgart\\.de|dhbw\\.de|heilbronn\\.dhbw\\.de|lehre\\.dhbw-mannheim\\.de|lehre\\.mosbach\\.dhbw\\.de|mosbach\\.dhbw\\.de)$');
    }

    function canCreateNotification(userId, data) {
      return data.senderId == request.auth.uid &&
             data.userId == userId &&
             (
               (data.type in ['slot_reminder', 'gym_alert'] && userId == request.auth.uid) ||
               (
                 data.type == 'new_message' &&
                 isValidId(data.resourceId) &&
                 isValidId(data.eventId) &&
                 data.id == data.eventId &&
                 exists(/databases/$(database)/documents/conversations/$(data.resourceId)) &&
                 isValidConversation(get(/databases/$(database)/documents/conversations/$(data.resourceId)).data) &&
                 get(/databases/$(database)/documents/conversations/$(data.resourceId)).data.id == data.resourceId &&
                 request.auth.uid in get(/databases/$(database)/documents/conversations/$(data.resourceId)).data.participantIds &&
                 userId in get(/databases/$(database)/documents/conversations/$(data.resourceId)).data.participantIds &&
                 exists(/databases/$(database)/documents/conversations/$(data.resourceId)/messages/$(data.eventId)) &&
                 isValidChatMessage(get(/databases/$(database)/documents/conversations/$(data.resourceId)/messages/$(data.eventId)).data) &&
                 get(/databases/$(database)/documents/conversations/$(data.resourceId)/messages/$(data.eventId)).data.id == data.eventId &&
                 get(/databases/$(database)/documents/conversations/$(data.resourceId)/messages/$(data.eventId)).data.conversationId == data.resourceId &&
                 get(/databases/$(database)/documents/conversations/$(data.resourceId)/messages/$(data.eventId)).data.senderId == request.auth.uid
               )
             );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }
    function isValidParticipantId(value) {
      // Firebase Auth UIDs are opaque identifiers; avoid regex evaluation for each group member.
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isValidTimestampString(value) {
      return value is string && value.size() <= 40 &&
             value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$');
    }

    // Firestore rules do not support arbitrary loops. Validate each bounded
    // list item explicitly so nested maps/objects cannot smuggle private fields
    // through a public profile read.
    function isBoundedStringList(values) {
      return values is list &&
             values.size() <= 10 &&
             (values.size() < 1 || (values[0] is string && values[0].size() <= 100)) &&
             (values.size() < 2 || (values[1] is string && values[1].size() <= 100)) &&
             (values.size() < 3 || (values[2] is string && values[2].size() <= 100)) &&
             (values.size() < 4 || (values[3] is string && values[3].size() <= 100)) &&
             (values.size() < 5 || (values[4] is string && values[4].size() <= 100)) &&
             (values.size() < 6 || (values[5] is string && values[5].size() <= 100)) &&
             (values.size() < 7 || (values[6] is string && values[6].size() <= 100)) &&
             (values.size() < 8 || (values[7] is string && values[7].size() <= 100)) &&
             (values.size() < 9 || (values[8] is string && values[8].size() <= 100)) &&
             (values.size() < 10 || (values[9] is string && values[9].size() <= 100));
    }

    function isValidCommunityProfile(data) {
      return data.keys().hasAll(['userId', 'firstName']) &&
             data.keys().hasOnly([
               'userId', 'firstName', 'lastNameInitial', 'courseOfStudy', 'bio',
               'isPublicPresence', 'trainingGoals', 'preferredTimes', 'interests', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.firstName is string && data.firstName.size() <= 50 &&
             (!('lastNameInitial' in data) || (data.lastNameInitial is string && data.lastNameInitial.size() <= 5)) &&
             (!('courseOfStudy' in data) || (data.courseOfStudy is string && data.courseOfStudy.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('isPublicPresence' in data) || data.isPublicPresence is bool) &&
             (!('trainingGoals' in data) || isBoundedStringList(data.trainingGoals)) &&
             (!('preferredTimes' in data) || isBoundedStringList(data.preferredTimes)) &&
             (!('interests' in data) || isBoundedStringList(data.interests)) &&
             (!('updatedAt' in data) || isValidTimestampString(data.updatedAt));
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'participantIds']) &&
             data.keys().hasOnly([
               'id', 'participantIds', 'participantNames', 'createdAt', 'title',
               'lastMessageText', 'lastMessageAt', 'lastSenderId'
             ]) &&
             isValidId(data.id) &&
             data.participantIds is list &&
             data.participantIds.size() >= 2 && data.participantIds.size() <= 10 &&
             (data.participantIds.size() < 1 || isValidParticipantId(data.participantIds[0])) &&
             (data.participantIds.size() < 2 || isValidParticipantId(data.participantIds[1])) &&
             (data.participantIds.size() < 3 || isValidParticipantId(data.participantIds[2])) &&
             (data.participantIds.size() < 4 || isValidParticipantId(data.participantIds[3])) &&
             (data.participantIds.size() < 5 || isValidParticipantId(data.participantIds[4])) &&
             (data.participantIds.size() < 6 || isValidParticipantId(data.participantIds[5])) &&
             (data.participantIds.size() < 7 || isValidParticipantId(data.participantIds[6])) &&
             (data.participantIds.size() < 8 || isValidParticipantId(data.participantIds[7])) &&
             (data.participantIds.size() < 9 || isValidParticipantId(data.participantIds[8])) &&
             (data.participantIds.size() < 10 || isValidParticipantId(data.participantIds[9])) &&
             (data.participantIds.size() < 2 || data.participantIds[0] != data.participantIds[1]) &&
             (data.participantIds.size() < 3 || data.participantIds[0] != data.participantIds[2]) &&
             (data.participantIds.size() < 4 || data.participantIds[0] != data.participantIds[3]) &&
             (data.participantIds.size() < 5 || data.participantIds[0] != data.participantIds[4]) &&
             (data.participantIds.size() < 6 || data.participantIds[0] != data.participantIds[5]) &&
             (data.participantIds.size() < 7 || data.participantIds[0] != data.participantIds[6]) &&
             (data.participantIds.size() < 8 || data.participantIds[0] != data.participantIds[7]) &&
             (data.participantIds.size() < 9 || data.participantIds[0] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[0] != data.participantIds[9]) &&
             (data.participantIds.size() < 3 || data.participantIds[1] != data.participantIds[2]) &&
             (data.participantIds.size() < 4 || data.participantIds[1] != data.participantIds[3]) &&
             (data.participantIds.size() < 5 || data.participantIds[1] != data.participantIds[4]) &&
             (data.participantIds.size() < 6 || data.participantIds[1] != data.participantIds[5]) &&
             (data.participantIds.size() < 7 || data.participantIds[1] != data.participantIds[6]) &&
             (data.participantIds.size() < 8 || data.participantIds[1] != data.participantIds[7]) &&
             (data.participantIds.size() < 9 || data.participantIds[1] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[1] != data.participantIds[9]) &&
             (data.participantIds.size() < 4 || data.participantIds[2] != data.participantIds[3]) &&
             (data.participantIds.size() < 5 || data.participantIds[2] != data.participantIds[4]) &&
             (data.participantIds.size() < 6 || data.participantIds[2] != data.participantIds[5]) &&
             (data.participantIds.size() < 7 || data.participantIds[2] != data.participantIds[6]) &&
             (data.participantIds.size() < 8 || data.participantIds[2] != data.participantIds[7]) &&
             (data.participantIds.size() < 9 || data.participantIds[2] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[2] != data.participantIds[9]) &&
             (data.participantIds.size() < 5 || data.participantIds[3] != data.participantIds[4]) &&
             (data.participantIds.size() < 6 || data.participantIds[3] != data.participantIds[5]) &&
             (data.participantIds.size() < 7 || data.participantIds[3] != data.participantIds[6]) &&
             (data.participantIds.size() < 8 || data.participantIds[3] != data.participantIds[7]) &&
             (data.participantIds.size() < 9 || data.participantIds[3] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[3] != data.participantIds[9]) &&
             (data.participantIds.size() < 6 || data.participantIds[4] != data.participantIds[5]) &&
             (data.participantIds.size() < 7 || data.participantIds[4] != data.participantIds[6]) &&
             (data.participantIds.size() < 8 || data.participantIds[4] != data.participantIds[7]) &&
             (data.participantIds.size() < 9 || data.participantIds[4] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[4] != data.participantIds[9]) &&
             (data.participantIds.size() < 7 || data.participantIds[5] != data.participantIds[6]) &&
             (data.participantIds.size() < 8 || data.participantIds[5] != data.participantIds[7]) &&
             (data.participantIds.size() < 9 || data.participantIds[5] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[5] != data.participantIds[9]) &&
             (data.participantIds.size() < 8 || data.participantIds[6] != data.participantIds[7]) &&
             (data.participantIds.size() < 9 || data.participantIds[6] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[6] != data.participantIds[9]) &&
             (data.participantIds.size() < 9 || data.participantIds[7] != data.participantIds[8]) &&
             (data.participantIds.size() < 10 || data.participantIds[7] != data.participantIds[9]) &&
             (data.participantIds.size() < 10 || data.participantIds[8] != data.participantIds[9]) &&
             (!('participantNames' in data) || (data.participantNames is map &&
               data.participantNames.keys().hasOnly(data.participantIds) &&
               data.participantNames.keys().hasAll(data.participantIds) &&
               (data.participantIds.size() < 1 || (data.participantNames[data.participantIds[0]] is string && data.participantNames[data.participantIds[0]].size() <= 60)) &&
               (data.participantIds.size() < 2 || (data.participantNames[data.participantIds[1]] is string && data.participantNames[data.participantIds[1]].size() <= 60)) &&
               (data.participantIds.size() < 3 || (data.participantNames[data.participantIds[2]] is string && data.participantNames[data.participantIds[2]].size() <= 60)) &&
               (data.participantIds.size() < 4 || (data.participantNames[data.participantIds[3]] is string && data.participantNames[data.participantIds[3]].size() <= 60)) &&
               (data.participantIds.size() < 5 || (data.participantNames[data.participantIds[4]] is string && data.participantNames[data.participantIds[4]].size() <= 60)) &&
               (data.participantIds.size() < 6 || (data.participantNames[data.participantIds[5]] is string && data.participantNames[data.participantIds[5]].size() <= 60)) &&
               (data.participantIds.size() < 7 || (data.participantNames[data.participantIds[6]] is string && data.participantNames[data.participantIds[6]].size() <= 60)) &&
               (data.participantIds.size() < 8 || (data.participantNames[data.participantIds[7]] is string && data.participantNames[data.participantIds[7]].size() <= 60)) &&
               (data.participantIds.size() < 9 || (data.participantNames[data.participantIds[8]] is string && data.participantNames[data.participantIds[8]].size() <= 60)) &&
               (data.participantIds.size() < 10 || (data.participantNames[data.participantIds[9]] is string && data.participantNames[data.participantIds[9]].size() <= 60)))) &&
             (!('createdAt' in data) || isValidTimestampString(data.createdAt)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 80)) &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
             (!('lastMessageAt' in data) || isValidTimestampString(data.lastMessageAt)) &&
             (!('lastSenderId' in data) ||
               (data.lastSenderId is string && data.lastSenderId in data.participantIds));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'senderId', 'text']) &&
             data.keys().hasOnly(['id', 'conversationId', 'senderId', 'senderName', 'text', 'createdAt']) &&
             isValidId(data.id) &&
             data.conversationId is string && data.conversationId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 60)) &&
             (!('createdAt' in data) || isValidTimestampString(data.createdAt));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'senderId', 'type', 'title', 'message', 'read']) &&
             data.keys().hasOnly([
               'id', 'userId', 'senderId', 'type', 'title', 'message', 'read',
               'linkUrl', 'resourceId', 'eventId', 'createdAt'
             ]) &&
             isValidId(data.id) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.type in ['partner_request', 'partner_accepted', 'new_message', 'slot_reminder', 'gym_alert'] &&
             data.title is string && data.title.size() <= 120 &&
             data.message is string && data.message.size() <= 300 &&
             data.read is bool &&
             (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.size() <= 500 && data.linkUrl.matches('^/([a-zA-Z0-9_?=&-][a-zA-Z0-9_/?=&-]*)?$'))) &&
             (!('resourceId' in data) || isValidId(data.resourceId)) &&
             (!('eventId' in data) || isValidId(data.eventId)) &&
             (!('createdAt' in data) || isValidTimestampString(data.createdAt));
    }

    function isValidPartnerRequest(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'status']) &&
             data.keys().hasOnly([
               'id', 'senderId', 'receiverId', 'senderName', 'receiverName',
               'proposedDate', 'note', 'status', 'isIncoming', 'createdAt', 'updatedAt'
             ]) &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128 &&
             data.senderId != data.receiverId &&
             data.status in ['pending', 'accepted', 'declined', 'cancelled'] &&
             (!('id' in data) || isValidId(data.id)) &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 60)) &&
             (!('receiverName' in data) || (data.receiverName is string && data.receiverName.size() <= 60)) &&
             (!('proposedDate' in data) || data.proposedDate == null || isValidTimestampString(data.proposedDate)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
             (!('isIncoming' in data) || data.isIncoming is bool) &&
             (!('createdAt' in data) || isValidTimestampString(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampString(data.updatedAt));
    }

    // Community Profiles
    match /community_profiles/{profileId} {
      // Validate stored documents too, so legacy/Admin-created records cannot leak extra fields.
      allow get: if isVerifiedDhbwUser() &&
                    isValidId(profileId) &&
                    isValidCommunityProfile(existing()) &&
                    profileId == existing().userId &&
                    (existing().userId == request.auth.uid || existing().isPublicPresence == true);
      // The authenticated API returns a safe DTO; Firestore rules cannot redact fields in list results.
      allow list: if false;
      allow create: if isVerifiedDhbwUser() &&
                       isValidId(profileId) &&
                       profileId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       isValidCommunityProfile(incoming());
      allow update: if isVerifiedDhbwUser() &&
                       isValidId(profileId) &&
                       profileId == request.auth.uid &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       isValidCommunityProfile(incoming());
      allow delete: if isVerifiedDhbwUser() &&
                       isValidId(profileId) &&
                       profileId == request.auth.uid &&
                       existing().userId == request.auth.uid;
    }

    // Training Partner Requests
    match /partner_requests/{requestId} {
      allow get: if isVerifiedDhbwUser() &&
                    isValidId(requestId) &&
                    isValidPartnerRequest(resource.data) &&
                    (!('id' in resource.data) || resource.data.id == requestId) &&
                    (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      // Firestore cannot redact unexpected fields from query results. The authenticated
      // API is the supported listing path and returns participant-scoped DTOs.
      allow list: if false;
    }

    // Direct Chat Conversations
    match /conversations/{conversationId} {
      allow get: if isVerifiedDhbwUser() &&
                    isValidId(conversationId) &&
                    isValidConversation(resource.data) &&
                    resource.data.id == conversationId &&
                    request.auth.uid in resource.data.participantIds;
      // Lists go through the authenticated API, which validates and allowlists every document.
      allow list: if false;
      allow update: if isVerifiedDhbwUser() &&
                       isValidId(conversationId) &&
                       isValidConversation(existing()) &&
                       existing().id == conversationId &&
                       request.auth.uid in existing().participantIds &&
                       isValidConversation(incoming()) &&
                       incoming().id == conversationId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageAt', 'lastSenderId']) &&
                       incoming().lastSenderId == request.auth.uid;

      // Nested Chat Messages
      match /messages/{messageId} {
        allow get: if isVerifiedDhbwUser() &&
                      isValidId(conversationId) &&
                      isValidId(messageId) &&
                      isValidChatMessage(resource.data) &&
                      resource.data.id == messageId &&
                      resource.data.conversationId == conversationId &&
                      exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                      isValidConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.id == conversationId &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // The API verifies parent-conversation participation and validates every message.
        allow list: if false;
        allow create: if isVerifiedDhbwUser() &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().conversationId == conversationId &&
                         isValidChatMessage(incoming()) &&
                         incoming().id == messageId &&
                         exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                         isValidConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.id == conversationId &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow delete: if isVerifiedDhbwUser() &&
                         isValidId(messageId) &&
                         existing().senderId == request.auth.uid &&
                         existing().id == messageId &&
                         existing().conversationId == conversationId &&
                         exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                         isValidConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.id == conversationId &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // User Private Notifications & Slot Reminders
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isVerifiedDhbwUser() &&
                    isValidId(userId) &&
                    isValidId(notificationId) &&
                    isValidNotification(resource.data) &&
                    resource.data.id == notificationId &&
                    userId == request.auth.uid;
      // The API validates notification schemas before returning any list result.
      allow list: if false;
      allow delete: if isVerifiedDhbwUser() && isValidId(userId) && isValidId(notificationId) && userId == request.auth.uid;
      allow update: if isVerifiedDhbwUser() &&
                       isValidId(userId) &&
                       isValidId(notificationId) &&
                       userId == request.auth.uid &&
                       existing().id == notificationId &&
                       incoming().id == notificationId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                       incoming().read is bool;
      allow create: if isVerifiedDhbwUser() &&
                       isValidId(userId) &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming()) &&
                       incoming().id == notificationId &&
                       canCreateNotification(userId, incoming());
    }
  }
}

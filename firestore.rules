rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isVerifiedDhbwUser() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             request.auth.token.email.lower().matches('^[^@]+@(bad-mergentheim\\.dhbw\\.de|badmergentheim\\.dhbw\\.de|dhbw-mannheim\\.de|dhbw-mosbach\\.de|dhbw-stuttgart\\.de|dhbw\\.de|heilbronn\\.dhbw\\.de|lehre\\.dhbw-mannheim\\.de)$');
    }

    function canCreateNotification(userId, data) {
      return data.senderId == request.auth.uid &&
             data.userId == userId &&
             (
               (data.type in ['slot_reminder', 'gym_alert'] && userId == request.auth.uid) ||
               (
                 data.type == 'new_message' &&
                 isValidId(data.resourceId) &&
                 isValidId(data.eventId) &&
                 exists(/databases/$(database)/documents/conversations/$(data.resourceId)) &&
                 request.auth.uid in get(/databases/$(database)/documents/conversations/$(data.resourceId)).data.participantIds &&
                 userId in get(/databases/$(database)/documents/conversations/$(data.resourceId)).data.participantIds &&
                 exists(/databases/$(database)/documents/conversations/$(data.resourceId)/messages/$(data.eventId)) &&
                 get(/databases/$(database)/documents/conversations/$(data.resourceId)/messages/$(data.eventId)).data.senderId == request.auth.uid
               )
             );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCommunityProfile(data) {
      return data.keys().hasAll(['userId', 'firstName']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.firstName is string && data.firstName.size() <= 50 &&
             (!('lastNameInitial' in data) || (data.lastNameInitial is string && data.lastNameInitial.size() <= 5)) &&
             (!('courseOfStudy' in data) || (data.courseOfStudy is string && data.courseOfStudy.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('isPublicPresence' in data) || data.isPublicPresence is bool) &&
             (!('trainingGoals' in data) || (data.trainingGoals is list && data.trainingGoals.size() <= 10)) &&
             (!('preferredTimes' in data) || (data.preferredTimes is list && data.preferredTimes.size() <= 10));
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'participantIds']) &&
             isValidId(data.id) &&
             data.participantIds is list &&
             data.participantIds.size() == 2 &&
             data.participantIds[0] is string &&
             data.participantIds[0].size() <= 128 &&
             data.participantIds[1] is string &&
             data.participantIds[1].size() <= 128 &&
             data.participantIds[0] != data.participantIds[1] &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
             (!('lastMessageAt' in data) || data.lastMessageAt is timestamp) &&
             (!('lastSenderId' in data) ||
               (data.lastSenderId is string && data.lastSenderId in data.participantIds));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'senderId', 'text']) &&
             isValidId(data.id) &&
             data.conversationId is string && data.conversationId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 60));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'senderId', 'type', 'title', 'message', 'read']) &&
             isValidId(data.id) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.type in ['partner_request', 'partner_accepted', 'new_message', 'slot_reminder', 'gym_alert'] &&
             data.title is string && data.title.size() <= 120 &&
             data.message is string && data.message.size() <= 300 &&
             data.read is bool;
    }

    // Connection Healthcheck Document
    match /test/{docId} {
      allow read: if true;
    }

    // Community Profiles
    match /community_profiles/{profileId} {
      allow get: if isVerifiedDhbwUser() &&
                    isValidId(profileId) &&
                    (existing().userId == request.auth.uid || existing().isPublicPresence == true);
      allow list: if isVerifiedDhbwUser() &&
                     (resource.data.userId == request.auth.uid || resource.data.isPublicPresence == true);
      allow create: if isVerifiedDhbwUser() &&
                       isValidId(profileId) &&
                       profileId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       isValidCommunityProfile(incoming());
      allow update: if isVerifiedDhbwUser() &&
                       isValidId(profileId) &&
                       profileId == request.auth.uid &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       isValidCommunityProfile(incoming());
      allow delete: if isVerifiedDhbwUser() &&
                       isValidId(profileId) &&
                       profileId == request.auth.uid &&
                       existing().userId == request.auth.uid;
    }

    // Training Partner Requests
    match /partner_requests/{requestId} {
      allow get: if isVerifiedDhbwUser() &&
                    isValidId(requestId) &&
                    (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if isVerifiedDhbwUser() &&
                     (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Direct Chat Conversations
    match /conversations/{conversationId} {
      allow get: if isVerifiedDhbwUser() &&
                    isValidId(conversationId) &&
                    isValidConversation(resource.data) &&
                    request.auth.uid in resource.data.participantIds;
      allow list: if isVerifiedDhbwUser() &&
                     request.auth.uid in resource.data.participantIds;
      allow update: if isVerifiedDhbwUser() &&
                       isValidId(conversationId) &&
                       isValidConversation(existing()) &&
                       request.auth.uid in existing().participantIds &&
                       isValidConversation(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageAt', 'lastSenderId']) &&
                       incoming().lastSenderId == request.auth.uid;

      // Nested Chat Messages
      match /messages/{messageId} {
        allow get: if isVerifiedDhbwUser() &&
                      isValidId(conversationId) &&
                      isValidId(messageId) &&
                      exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow list: if isVerifiedDhbwUser() &&
                       isValidId(conversationId) &&
                       exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isVerifiedDhbwUser() &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().conversationId == conversationId &&
                         isValidChatMessage(incoming()) &&
                         exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow delete: if isVerifiedDhbwUser() &&
                         isValidId(messageId) &&
                         existing().senderId == request.auth.uid &&
                         exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // User Private Notifications & Slot Reminders
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isVerifiedDhbwUser() && isValidId(userId) && isValidId(notificationId) && userId == request.auth.uid;
      allow list: if isVerifiedDhbwUser() && isValidId(userId) && userId == request.auth.uid;
      allow delete: if isVerifiedDhbwUser() && isValidId(userId) && isValidId(notificationId) && userId == request.auth.uid;
      allow update: if isVerifiedDhbwUser() &&
                       isValidId(userId) &&
                       isValidId(notificationId) &&
                       userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                       incoming().read is bool;
      allow create: if isVerifiedDhbwUser() &&
                       isValidId(userId) &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming()) &&
                       canCreateNotification(userId, incoming());
    }
  }
}

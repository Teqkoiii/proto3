{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "dev:dhbw-test": "node scripts/start-dhbw-test-api.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts src/services/gymRepository.test.ts src/services/firebaseAppConfig.test.ts src/features/gym/calendarBookingSubmission.test.ts scripts/*.test.mjs",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-gym-auth-test \"node --import tsx --test --test-concurrency=1 tests/firebase/firestore.rules.test.ts tests/firebase/auth-emulator.integration.ts tests/firebase/api-emulator.integration.ts\"",
    "test:api:isolated": "firebase emulators:exec --only auth,firestore --project demo-gym-auth-test \"node scripts/start-test-api.mjs\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

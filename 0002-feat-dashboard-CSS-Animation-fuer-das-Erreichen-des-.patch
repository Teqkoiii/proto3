+/* ==========================================================================
+   Wochenziel Erreicht – CSS-Animationen & Motivierender Fortschritt
+   ========================================================================== */
+
+.progress-glance {
+  position: relative;
+  overflow: hidden;
+  transition: border-color 0.4s ease, box-shadow 0.4s ease;
+}
+
+/* Reached state card highlighting */
+.progress-glance.is-goal-reached {
+  border-color: rgba(142, 189, 156, 0.45);
+  background: linear-gradient(155deg, rgba(22, 38, 29, 0.6) 0%, rgba(18, 26, 23, 0.8) 40%, rgba(15, 20, 26, 0.95) 100%);
+  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(142, 189, 156, 0.28);
+  animation: goalGlowPulse 4s ease-in-out infinite;
+}
+
+@keyframes goalGlowPulse {
+  0%, 100% {
+    border-color: rgba(142, 189, 156, 0.4);
+    box-shadow: 0 6px 26px rgba(0, 0, 0, 0.35), 0 0 16px rgba(16, 185, 129, 0.12);
+  }
+  50% {
+    border-color: rgba(245, 158, 11, 0.6);
+    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 26px rgba(245, 158, 11, 0.24), 0 0 0 1px rgba(245, 158, 11, 0.4);
+  }
+}
+
+/* Confetti Container & Particles */
+.goal-confetti-container {
+  position: absolute;
+  top: 52px;
+  left: 48px;
+  width: 1px;
+  height: 1px;
+  pointer-events: none;
+  z-index: 10;
+}
+
+.goal-confetti-particle {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: var(--size, 7px);
+  height: var(--size, 7px);
+  border-radius: var(--radius, 2px);
+  background: var(--bg, #fbbf24);
+  opacity: 0;
+  transform: translate(0, 0) scale(0);
+  animation: confettiBurst 2.2s cubic-bezier(0.2, 0.9, 0.3, 1) var(--delay, 0s) forwards;
+}
+
+@keyframes confettiBurst {
+  0% {
+    transform: translate(0, 0) scale(0) rotate(0deg);
+    opacity: 1;
+  }
+  20% {
+    transform: translate(calc(var(--tx) * 0.4), calc(var(--ty) * 0.5 - 18px)) scale(1.3) rotate(calc(var(--rot) * 0.3));
+    opacity: 1;
+  }
+  60% {
+    transform: translate(calc(var(--tx) * 0.8), calc(var(--ty) * 0.8 + 6px)) scale(1) rotate(calc(var(--rot) * 0.7));
+    opacity: 0.9;
+  }
+  100% {
+    transform: translate(var(--tx), calc(var(--ty) + 32px)) scale(0.3) rotate(var(--rot));
+    opacity: 0;
+  }
+}
+
+/* Goal Hero Headers */
+.goal-reached-hero,
+.goal-pending-hero {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin-top: 14px;
+}
+
+.goal-badge-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+/* Trophy animation wrapper */
+.goal-trophy-wrapper {
+  position: relative;
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  flex-shrink: 0;
+  border-radius: 12px;
+  background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(16, 185, 129, 0.2));
+  border: 1px solid rgba(245, 158, 11, 0.5);
+  color: #fbbf24;
+  box-shadow: 0 0 16px rgba(245, 158, 11, 0.25);
+  animation: trophyBounce 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+
+.trophy-bounce-icon {
+  animation: trophyGleam 2.5s ease-in-out infinite 1.2s;
+}
+
+@keyframes trophyBounce {
+  0% {
+    transform: scale(0.4) rotate(-15deg);
+    opacity: 0;
+  }
+  50% {
+    transform: scale(1.22) rotate(8deg);
+  }
+  75% {
+    transform: scale(0.92) rotate(-4deg);
+  }
+  100% {
+    transform: scale(1) rotate(0deg);
+    opacity: 1;
+  }
+}
+
+@keyframes trophyGleam {
+  0%, 100% {
+    transform: scale(1);
+    filter: drop-shadow(0 0 2px rgba(251, 191, 36, 0.4));
+  }
+  50% {
+    transform: scale(1.12);
+    filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.9));
+  }
+}
+
+/* Pulsing aura ring around trophy */
+.goal-trophy-pulse-ring {
+  position: absolute;
+  inset: -4px;
+  border-radius: 16px;
+  border: 1.5px solid rgba(245, 158, 11, 0.6);
+  pointer-events: none;
+  animation: pulseRing 2.4s cubic-bezier(0.1, 0.8, 0.2, 1) infinite;
+}
+
+@keyframes pulseRing {
+  0% {
+    transform: scale(0.85);
+    opacity: 0.9;
+  }
+  60% {
+    transform: scale(1.35);
+    opacity: 0;
+  }
+  100% {
+    transform: scale(1.4);
+    opacity: 0;
+  }
+}
+
+/* Pending Goal Icon */
+.goal-icon-wrapper {
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  flex-shrink: 0;
+  border-radius: 12px;
+  background: var(--gym-surface-2);
+  border: 1px solid var(--gym-border);
+  color: var(--gym-accent);
+}
+
+.goal-achievement-info {
+  display: flex;
+  min-width: 0;
+  flex: 1;
+  flex-direction: column;
+  gap: 3px;
+}
+
+/* Celebratory Pill Badge */
+.goal-reached-pill {
+  display: inline-flex;
+  align-items: center;
+  align-self: flex-start;
+  gap: 6px;
+  padding: 3px 10px;
+  border-radius: 999px;
+  background: linear-gradient(90deg, rgba(16, 185, 129, 0.28), rgba(245, 158, 11, 0.28));
+  border: 1px solid rgba(245, 158, 11, 0.55);
+  color: #fef08a;
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
+  animation: badgePop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+
+@keyframes badgePop {
+  0% {
+    transform: scale(0.7);
+    opacity: 0;
+  }
+  60% {
+    transform: scale(1.08);
+  }
+  100% {
+    transform: scale(1);
+    opacity: 1;
+  }
+}
+
+.sparkle-icon {
+  color: #fde047;
+  animation: sparkleTwinkle 2s ease-in-out infinite;
+}
+
+@keyframes sparkleTwinkle {
+  0%, 100% {
+    transform: scale(0.9) rotate(0deg);
+    opacity: 0.7;
+  }
+  50% {
+    transform: scale(1.35) rotate(90deg);
+    opacity: 1;
+  }
+}
+
+.goal-pending-pill {
+  display: inline-flex;
+  align-items: center;
+  align-self: flex-start;
+  gap: 6px;
+  padding: 3px 9px;
+  border-radius: 999px;
+  background: rgba(142, 189, 156, 0.12);
+  border: 1px solid rgba(142, 189, 156, 0.25);
+  color: var(--gym-accent-strong);
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.goal-achievement-copy {
+  margin: 0;
+  color: #c9d4cd;
+  font-size: 11px;
+  line-height: 1.4;
+}
+
+/* Progress Bar Track & Fill */
+.goal-progress-wrap {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.goal-progress-track {
+  position: relative;
+  height: 8px;
+  border-radius: 999px;
+  background: #1c232a;
+  overflow: hidden;
+  border: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.goal-progress-track.is-achieved {
+  background: #19251e;
+  border-color: rgba(16, 185, 129, 0.35);
+  box-shadow: 0 0 10px rgba(16, 185, 129, 0.25);
+}
+
+.goal-progress-fill {
+  position: relative;
+  height: 100%;
+  border-radius: inherit;
+  background: var(--gym-accent);
+  transition: width 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
+  animation: barFillAnim 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
+}
+
+@keyframes barFillAnim {
+  from {
+    width: 0% !important;
+  }
+  to {
+    width: var(--target-width, 100%) !important;
+  }
+}
+
+/* Celebratory Shimmering Bar */
+.goal-progress-fill.is-achieved {
+  background: linear-gradient(90deg, #10b981 0%, #34d399 30%, #fbbf24 60%, #10b981 100%);
+  background-size: 250% 100%;
+  box-shadow: 0 0 14px rgba(52, 211, 153, 0.6), 0 0 24px rgba(251, 191, 36, 0.35);
+  animation: barFillAnim 0.9s ease-out forwards, shimmerFlow 3s linear infinite;
+}
+
+@keyframes shimmerFlow {
+  0% {
+    background-position: 250% 0;
+  }
+  100% {
+    background-position: -250% 0;
+  }
+}
+
+.goal-shimmer-sheen {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.4) 50%, transparent 100%);
+  animation: sheenSlide 2.2s infinite ease-in-out;
+}
+
+@keyframes sheenSlide {
+  0% {
+    transform: translateX(-150%);
+  }
+  100% {
+    transform: translateX(250%);
+  }
+}
+
+/* Step Dots */
+.goal-step-dots {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.goal-step-dot {
+  display: grid;
+  place-items: center;
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: #1a2229;
+  border: 1px solid var(--gym-border);
+  color: var(--gym-muted);
+  font-size: 10px;
+  font-weight: 600;
+  transition: all 0.3s ease;
+}
+
+.goal-step-dot.is-completed {
+  background: linear-gradient(135deg, #10b981, #059669);
+  border-color: #34d399;
+  color: #ffffff;
+  box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
+  animation: dotBounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+
+.goal-step-dot.is-bonus {
+  background: linear-gradient(135deg, #f59e0b, #d97706);
+  border-color: #fcd34d;
+  color: #ffffff;
+  box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
+  animation: dotBounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+
+@keyframes dotBounceIn {
+  0% {
+    transform: scale(0.4);
+    opacity: 0;
+  }
+  70% {
+    transform: scale(1.25);
+  }
+  100% {
+    transform: scale(1);
+    opacity: 1;
+  }
+}
+
+/* Footer Row */
+.goal-footer-row {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 12px;
+  margin-top: 2px;
+}
+
+.goal-footer-row .glance-stats {
+  margin-top: 0;
+}
+
+.goal-actions-group {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+/* Celebrate Action Button */
+.goal-celebrate-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 32px;
+  padding: 0 12px;
+  border-radius: 999px;
+  background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(16, 185, 129, 0.2));
+  border: 1px solid rgba(245, 158, 11, 0.5);
+  color: #fde68a;
+  font-size: 11px;
+  font-weight: 650;
+  cursor: pointer;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
+  transition: all 0.2s ease;
+}
+
+.goal-celebrate-btn:hover {
+  background: linear-gradient(135deg, rgba(245, 158, 11, 0.35), rgba(16, 185, 129, 0.35));
+  border-color: rgba(245, 158, 11, 0.8);
+  transform: translateY(-1px) scale(1.03);
+  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
+}
+
+.goal-celebrate-btn:active {
+  transform: translateY(1px) scale(0.97);
+}
+
+/* Preview Toggle Button */
+.goal-preview-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  min-height: 28px;
+  padding: 0 9px;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.05);
+  border: 1px solid var(--gym-border);
+  color: var(--gym-muted);
+  font-size: 10px;
+  font-weight: 550;
+  cursor: pointer;
+  transition: all 0.2s ease;
+}
+
+.goal-preview-btn:hover {
+  color: var(--gym-text);
+  border-color: var(--gym-accent);
+  background: rgba(142, 189, 156, 0.1);
+}
+
+.goal-preview-btn.is-active {
+  background: rgba(245, 158, 11, 0.15);
+  border-color: rgba(245, 158, 11, 0.4);
+  color: #fbbf24;
+}
+
+/* Accessibility: Reduced Motion */
+@media (prefers-reduced-motion: reduce) {
+  .progress-glance.is-goal-reached,
+  .goal-trophy-wrapper,
+  .trophy-bounce-icon,
+  .goal-trophy-pulse-ring,
+  .goal-reached-pill,
+  .sparkle-icon,
+  .goal-confetti-particle,
+  .goal-progress-fill,
+  .goal-progress-fill.is-achieved,
+  .goal-shimmer-sheen,
+  .goal-step-dot.is-completed,
+  .goal-step-dot.is-bonus {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+@media (max-width: 600px) {
+  .goal-footer-row {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 12px;
+  }
+
+  .goal-actions-group {
+    width: 100%;
+    justify-content: flex-end;
+  }
+}
+
+
-- 
2.34.1


+
+/* Day Inspector Deep Dive Panel */
+.week-day-inspector {
+  margin-top: 20px;
+  padding: 20px;
+  border-radius: 14px;
+  background: #11161d;
+  border: 1px solid var(--gym-border-strong);
+}
+
+.inspector-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin-bottom: 16px;
+  padding-bottom: 14px;
+  border-bottom: 1px solid var(--gym-border);
+}
+
+.inspector-date-title {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.inspector-date-title h3 {
+  margin: 0;
+  font-size: 16px;
+  font-weight: 700;
+  color: var(--gym-text);
+}
+
+.inspector-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 16px;
+}
+
+.inspector-section {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  background: var(--gym-surface-2);
+  border: 1px solid var(--gym-border);
+  border-radius: 12px;
+  padding: 14px;
+}
+
+.inspector-section-title {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 12px;
+  font-weight: 650;
+  color: var(--gym-muted);
+}
+
+.inspector-item-card {
+  background: rgba(0, 0, 0, 0.25);
+  border: 1px solid var(--gym-border);
+  border-radius: 10px;
+  padding: 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.inspector-item-card.is-workout {
+  border-left: 3px solid #34d399;
+}
+
+.inspector-item-card.is-planned {
+  border-left: 3px solid #60a5fa;
+}
+
+.inspector-item-card.is-reservation {
+  border-left: 3px solid #c084fc;
+}
+
+.inspector-item-card.is-community {
+  border-left: 3px solid var(--gym-dim);
+}
+
+.inspector-item-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+
+.inspector-item-name {
+  font-size: 13px;
+  font-weight: 650;
+  color: var(--gym-text);
+}
+
+.inspector-exercise-list {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-top: 6px;
+  padding-top: 6px;
+  border-top: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.inspector-exercise-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 11px;
+  color: var(--gym-muted);
+}
+
+.inspector-exercise-row span:first-child {
+  color: #e2e8f0;
+  font-weight: 500;
+}
+
+/* Responsive adjustments for mobile */
+@media (max-width: 900px) {
+  .week-grid-container {
+    display: flex;
+    overflow-x: auto;
+    padding-bottom: 8px;
+    scroll-snap-type: x mandatory;
+    gap: 8px;
+  }
+
+  .week-day-col {
+    min-width: 150px;
+    flex: 0 0 150px;
+    scroll-snap-align: start;
+  }
+}
+
+@media (max-width: 600px) {
+  .week-toolbar {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+
+  .week-nav-group {
+    width: 100%;
+    justify-content: space-between;
+  }
+
+  .week-quick-stats {
+    width: 100%;
+  }
+
+  .calendar-view-header {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+
+  .view-mode-tabs {
+    width: 100%;
+  }
+
+  .view-mode-btn {
+    flex: 1;
+    justify-content: center;
+  }
+}
+

+}
+
+.modal-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 16px;
+}
+
+.modal-header h2 {
+  font-size: 17px;
+  font-weight: 700;
+  margin: 0;
+}
+
+.modal-actions {
+  display: flex;
+  gap: 10px;
+  justify-content: flex-end;
+  margin-top: 16px;
+}
+
+/* ==========================================================================
+   Wochenansicht (Weekly Calendar View)
+   ========================================================================== */
+.calendar-view-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin-bottom: 16px;
+}
+
+.view-mode-tabs {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 4px;
+  border-radius: 10px;
+  background: rgba(0, 0, 0, 0.35);
+  border: 1px solid var(--gym-border);
+}
+
+.view-mode-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 6px 14px;
+  border-radius: 7px;
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--gym-muted);
+  background: transparent;
+  border: none;
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.view-mode-btn:hover {
+  color: var(--gym-text);
+}
+
+.view-mode-btn.is-active {
+  background: var(--gym-surface-2);
+  color: var(--gym-text);
+  border: 1px solid var(--gym-border-strong);
+  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
+}
+
+.week-panel {
+  padding: 22px;
+  margin-bottom: 20px;
+}
+
+.week-toolbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 16px;
+  padding-bottom: 18px;
+  border-bottom: 1px solid var(--gym-border);
+}
+
+.week-nav-group {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.week-nav-btn {
+  display: grid;
+  place-items: center;
+  width: 34px;
+  height: 34px;
+  border-radius: 9px;
+  background: var(--gym-surface-2);
+  border: 1px solid var(--gym-border);
+  color: var(--gym-muted);
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.week-nav-btn:hover:not(:disabled) {
+  color: var(--gym-text);
+  border-color: var(--gym-border-strong);
+  background: #202933;
+}
+
+.week-nav-btn:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+
+.week-today-btn {
+  padding: 0 12px;
+  height: 34px;
+  border-radius: 9px;
+  background: var(--gym-surface-2);
+  border: 1px solid var(--gym-border);
+  color: var(--gym-text);
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.week-today-btn:hover {
+  background: #202933;
+  border-color: var(--gym-border-strong);
+}
+
+.week-today-btn.is-current {
+  border-color: rgba(167, 216, 182, 0.35);

# Copy to .env.dhbw-test.local and fill in the Web App values from Firebase Console.
# This file must never contain a service-account private key.
FIREBASE_PROJECT_ID=dhbw-gym-test
DHBW_TEST_CREDENTIALS_CONFIRMED=
GYM_APP_DATABASE_PATH=C:/Users/soner2k/AppData/Local/DHBW-Gym-Test/gym-app-test.sqlite3
HOST=127.0.0.1
PORT=43128

VITE_FIREBASE_PROJECT_ID=dhbw-gym-test
VITE_FIREBASE_API_KEY=REPLACE_WITH_TEST_WEB_APP_API_KEY
VITE_FIREBASE_APP_ID=REPLACE_WITH_TEST_WEB_APP_APP_ID
VITE_FIREBASE_AUTH_DOMAIN=dhbw-gym-test.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=93969186943
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Set to 1 only when deliberately reusing the separate local test database.
DHBW_TEST_DATABASE_REUSE=
